# Meta : Get script dir

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# gitstatus

source $SCRIPT_DIR/gitstatus/gitstatus.prompt.sh

sanatize_prompt() {
    if [[ -n "$GITSTATUS_PROMPT" ]]; then
        GITSTATUS_PROMPT=$'\001\e[0;32m\002('"$GITSTATUS_PROMPT"$'\001\e[0;32m\002)'
    else
        GITSTATUS_PROMPT=""
    fi
}

# PS1

check_last_cmd(){    
    if [ "$?" == "0" ]; then 
        DOLLAR_COLOR="\e[0;32m";
    else 
        DOLLAR_COLOR="\e[0;31m";
    fi
}

_bash_setup_prompt_command_has() {
    local command="$1"
    local prompt_command="${PROMPT_COMMAND//$'\n'/;}"

    [[ ";$prompt_command;" == *";$command;"* ]]
}

_bash_setup_prompt_command_prepend() {
    local command="$1"

    _bash_setup_prompt_command_has "$command" && return

    if [[ -n "$PROMPT_COMMAND" ]]; then
        PROMPT_COMMAND="$command"$'\n'"$PROMPT_COMMAND"
    else
        PROMPT_COMMAND="$command"
    fi
}

_bash_setup_prompt_command_append() {
    local command="$1"

    _bash_setup_prompt_command_has "$command" && return

    if [[ -n "$PROMPT_COMMAND" ]]; then
        # Remove trailing newlines before appending the command.
        while [[ "$PROMPT_COMMAND" == *$'\n' ]]; do
            PROMPT_COMMAND="${PROMPT_COMMAND%$'\n'}"
        done
        PROMPT_COMMAND+=$'\n'"$command"
    else
        PROMPT_COMMAND="$command"
    fi
}

_bash_setup_prompt_command_append sanatize_prompt
_bash_setup_prompt_command_prepend _check_curr_bookmark
_bash_setup_prompt_command_prepend check_last_cmd
